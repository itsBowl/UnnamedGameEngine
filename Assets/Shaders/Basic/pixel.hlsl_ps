cbuffer DrawData : register(b1)
{
    uint index;
    uint batchID;
};

struct PSInput
{
    float4 pos : SV_POSITION;
    float3 colour : COLOR;
};

float3 hsv2rgb(float3 c) {
    float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * lerp(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}


float3 debugColor(uint id)
{
    //magic is 1/phi 
    float hue = frac(float(id) * 0.61803398875);
    return hsv2rgb(float3(hue, 0.8, 1.0));
}

float4 PSMain(PSInput input) : SV_TARGET
{
    float3 c1 = float3(1.f, 0.f, 0.f);
    float3 c2 = float3(0.f, 1.f, 0.f);
    float3 c3 = float3(0.f, 0.f, 1.f);
    float3 c4 = float3(1.f, 1.f, 1.f);

    float3 vcol = input.colour;

    //return float4(1.0, 0.0, 0.0, 1.0);

    return float4(debugColor(batchID), 1.f);
}